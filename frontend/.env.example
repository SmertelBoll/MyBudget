# Copy to .env. Only public values here: everything EXPO_PUBLIC_* is built into the app.

# Backend address. In a browser on this PC: http://localhost:4444
# On a phone (Expo Go), localhost is the phone itself: use this PC's LAN address, e.g. http://192.168.0.10:4444,
# or the Render URL, e.g. https://mybudget-api-uqdt.onrender.com
EXPO_PUBLIC_API_URL=http://localhost:4444

# Google sign-in, later (see TODO.md)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
