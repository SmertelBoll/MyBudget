# Copy to .env and fill in. Never commit .env.

PORT=4444
NODE_ENV=development

# MongoDB Atlas connection string, with the database name, e.g. ...mongodb.net/mybudget?retryWrites=true
MONGODB_URI=

# Only if connecting fails locally with "querySrv ECONNREFUSED": DNS servers for Node, e.g. 1.1.1.1,8.8.8.8.
# Not needed on Render.
DNS_SERVERS=

# Two different long random strings. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Access token lifetime (jsonwebtoken format) and days of inactivity before a session ends.
ACCESS_TTL=15m
REFRESH_IDLE_DAYS=180

# Comma-separated list of allowed registration domains, e.g. gmail.com. Empty = any domain.
ALLOWED_EMAIL_DOMAINS=

# Google OAuth client ids allowed as the ID-token audience (web, iOS, Android), comma-separated.
GOOGLE_CLIENT_IDS=

# Browser origins allowed by CORS, comma-separated. The mobile app doesn't need any.
CORS_ORIGINS=

# bcrypt cost
BCRYPT_ROUNDS=12

# Exchange rates (both USD-based, no key needed)
RATES_API_URL=https://open.er-api.com/v6/latest/USD
RATES_FALLBACK_URL=https://api.frankfurter.app/latest?from=USD

# Photo storage: the same Cloudinary account as MovieList works; photos go to a separate folder.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=MyBudget

# Optional: ipinfo.io token for the approximate city/country in the sessions list.
IPINFO_TOKEN=

# Optional: forward "Contact the support" messages by email. Messages are always saved in the database.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SUPPORT_EMAIL=
